# Copy to .env and fill in your values.
# Never commit .env.

# App
APP_ENV=
API_KEY=
LOG_LEVEL=

# CORS (JSON list)
CORS_ALLOWED_ORIGINS=

# AI provider mode: stub | chain
AI_PROVIDER_MODE=
AI_TIMEOUT_SECONDS=

# Provider keys (omit or leave empty to skip that provider)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional — omit to use app defaults from Settings
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=
