# Copy this file to .env and fill in your values.
# API_KEY and the provider API keys must never be committed to version control.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development

# Shared secret the Nest API sends as `Authorization: Bearer {API_KEY}`.
API_KEY=change-me

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=[]

# ---------------------------------------------------------------------------
# AI provider chain — Gemini (primary) -> Groq (fallback) -> OpenRouter (free)
#
# AI_PROVIDER_MODE=stub returns deterministic placeholder JSON and never
# calls a real provider — use it locally or in CI without spending quota.
# AI_PROVIDER_MODE=chain calls providers in order, skipping any whose API
# key is absent; if none are configured it also falls back to the stub.
# ---------------------------------------------------------------------------
AI_PROVIDER_MODE=stub

GEMINI_API_KEY=change-me
GROQ_API_KEY=change-me
OPENROUTER_API_KEY=change-me

GEMINI_MODEL=change-me
GROQ_MODEL=change-me
OPENROUTER_MODEL=change-me

AI_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
