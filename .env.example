# Copy to .env and fill in your values.
# Never commit .env.

# App
APP_ENV=
API_KEY=
LOG_LEVEL=

# CORS (JSON list of explicit allowed origins). Empty/omitted = no CORS
# middleware registered at all (this service sits behind car-faults-api,
# not called directly from browsers). Never use "*".
CORS_ALLOWED_ORIGINS=

# Rate limit applied to POST /lookup and POST /translate, e.g. "60/minute"
RATE_LIMIT=

# Redis URL for distributed rate limiting, e.g. "redis://localhost:6379".
# Omit/leave empty to use in-memory rate limiting (fine for a single
# dev/local instance, but not shared across multiple processes/instances).
REDIS_URL=

# Max accepted request body size in bytes for POST /lookup and POST
# /translate. Omit to use the app default (256 KiB).
MAX_REQUEST_BODY_BYTES=

# AI provider mode: stub | chain
AI_PROVIDER_MODE=
AI_TIMEOUT_SECONDS=

# Provider keys (omit or leave empty to skip that provider)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional - omit to use app defaults from Settings
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=

# RAG (Fase 1 - keyword search over the app/knowledge/ corpus, applies only
# to /lookup). Omit to use app defaults (enabled, 5 chunks, app/knowledge).
RAG_ENABLED=
RAG_MAX_CHUNKS=
KNOWLEDGE_DIR=
