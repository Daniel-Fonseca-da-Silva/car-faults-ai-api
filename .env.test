# Committed test defaults - no secrets. Loaded by tests/conftest.py before
# .env, so local .env values never leak into the test suite.
APP_ENV=test
API_KEY=test-api-key

CORS_ALLOWED_ORIGINS=[]

AI_PROVIDER_MODE=

GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=

AI_TIMEOUT_SECONDS=

LOG_LEVEL=

# Off by default in the API/e2e test suite so the stub-provider fixtures
# stay deterministic regardless of the knowledge corpus. Retrieval and
# prompt-injection behaviour are covered directly against RAG_ENABLED=true
# in tests/test_keyword_retriever.py and tests/test_prompts_and_util.py.
RAG_ENABLED=
